        "frequency": {
          "type": "number",
          "required": false,
          "note": "单位 Hz"
        },
        "amplitude": {
          "type": "number",
          "required": false,
          "note": "单位 div"
        },
        "persistenceMs": {
          "type": "number",
          "required": false,
          "note": "单位 ms"
        },
        "phosphorColor": {
          "type": "color",
          "required": false
        },
        "sweepRate": {
          "type": "number",
          "required": false,
          "note": "单位 sweeps/s"
