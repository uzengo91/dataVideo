          "type": "color",
          "required": false
        }
      }
    },
    {
      "id": "oscilloscope-trace",
      "name": "示波器波形（官方）",
      "description": "官方块：示波器风格波形绘制，支持数据序列输入。",
      "sceneHint": "信号/数据波形展示",
      "html": "html/oscilloscope-trace.html",
      "duration": {
        "min": 6,
        "max": 12
      },
      "variables": {
        "waveform": {
          "type": "enum",
          "required": false,
