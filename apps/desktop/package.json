{
  "name": "@data-news/desktop",
  "version": "0.3.1",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.datanews.studio",
    "productName": "dataNews",
    "directories": {
      "output": "../../build/desktop"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/assets/templates",
        "to": "templates"
      },
      {
        "from": "../../apps/web/dist",
        "to": "web-dist"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "../../build/release/macos-arm64",
          "to": "bin",
          "filter": [
            "dataVideo-server"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "dir"
      ],
      "extraResources": [
        {
          "from": "../../build/release/windows-x64",
          "to": "bin",
          "filter": [
            "dataVideo-server.exe"
          ]
        }
      ]
    }
  }
}